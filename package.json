{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "description": "UI, API and accessibility test automation framework built with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --project=a11y",
    "report": "playwright show-report"
  },
  "author": "Muhammad Taha Khan",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}

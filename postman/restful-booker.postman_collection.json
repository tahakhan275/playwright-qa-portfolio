{
  "info": {
    "_postman_id": "16d4ae05-d405-4a2a-a393-e6f524ea84e6",
    "name": "Restful Booker \u2013 API test suite",
    "description": "Postman API tests for the public Restful Booker API: health check, token authentication, chained CRUD with dynamic test data, JSON schema validation, search, negative and security checks (403 without token, 404, invalid body) and clean-up. Runs in CI with Newman.\n\nAuthor: Muhammad Taha Khan",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health check",
      "item": [
        {
          "name": "Ping \u2013 service is up",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response time is under 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Authentication",
      "item": [
        {
          "name": "Create token \u2013 valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Token is returned', () => { pm.expect(json.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.test('Response time is under 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create token \u2013 wrong password (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No token is issued', () => pm.expect(pm.response.json().token).to.be.undefined);",
                  "pm.test('Reason says bad credentials', () => pm.expect(pm.response.json().reason).to.eql('Bad credentials'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Booking CRUD (chained)",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstName}}\",\n  \"lastname\": \"Khan\",\n  \"totalprice\": {{totalPrice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Booking id is a number', () => pm.expect(json.bookingid).to.be.a('number'));",
                  "pm.test('Response matches create-booking schema', () => pm.response.to.have.jsonSchema({ type: 'object', required: ['bookingid', 'booking'], properties: { bookingid: { type: 'number' }, booking: JSON.parse(pm.collectionVariables.get('bookingSchema')) } }));",
                  "pm.test('Saved data matches what was sent', () => {",
                  "  pm.expect(json.booking.firstname).to.eql(pm.collectionVariables.get('firstName'));",
                  "  pm.expect(json.booking.totalprice).to.eql(Number(pm.collectionVariables.get('totalPrice')));",
                  "  pm.expect(json.booking.bookingdates.checkin).to.eql(pm.collectionVariables.get('checkin'));",
                  "});",
                  "pm.collectionVariables.set('bookingId', json.bookingid);",
                  "pm.test('Response time is under 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Random test data so every run creates a fresh, unique booking",
                  "const names = ['Taha','Ayesha','Bilal','Sara','Omar'];",
                  "pm.collectionVariables.set('firstName', names[Math.floor(Math.random()*names.length)] + Date.now().toString().slice(-4));",
                  "pm.collectionVariables.set('totalPrice', Math.floor(Math.random()*400) + 100);",
                  "const d = new Date(); d.setDate(d.getDate() + 30);",
                  "const out = new Date(d); out.setDate(out.getDate() + 3);",
                  "pm.collectionVariables.set('checkin', d.toISOString().slice(0,10));",
                  "pm.collectionVariables.set('checkout', out.toISOString().slice(0,10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get booking by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Matches booking schema', () => pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get('bookingSchema'))));",
                  "pm.test('Returns the booking we created', () => pm.expect(pm.response.json().firstname).to.eql(pm.collectionVariables.get('firstName')));",
                  "pm.test('Response time is under 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search bookings by first name",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstName}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(b => b.bookingid);",
                  "pm.test('Search result contains our booking', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId'))));",
                  "pm.test('Response time is under 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update booking (PUT) \u2013 with token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstName}}\",\n  \"lastname\": \"Khan-Updated\",\n  \"totalprice\": 250,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Fields were replaced', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.lastname).to.eql('Khan-Updated');",
                  "  pm.expect(b.depositpaid).to.eql(false);",
                  "});",
                  "pm.test('Response time is under 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Partial update (PATCH) \u2013 with token",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalneeds\": \"Airport pickup\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only additionalneeds changed', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.additionalneeds).to.eql('Airport pickup');",
                  "  pm.expect(b.lastname).to.eql('Khan-Updated');",
                  "});",
                  "pm.test('Response time is under 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Negative and security checks",
      "item": [
        {
          "name": "Update without token is forbidden",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Hacker\",\n  \"lastname\": \"Test\",\n  \"totalprice\": 1,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-01\",\n    \"checkout\": \"2027-01-02\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete with invalid token is forbidden",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token=invalid123"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get non-existent booking returns 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create booking with missing fields is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"OnlyName\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server does not return 200 for an invalid body', () => pm.expect(pm.response.code).to.not.eql(200));",
                  "pm.test('No booking id is returned', () => { let j = {}; try { j = pm.response.json(); } catch (e) {} pm.expect(j.bookingid).to.be.undefined; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Clean-up",
      "item": [
        {
          "name": "Delete booking \u2013 with token",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (Restful Booker returns 201 on delete)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deleted booking is gone",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
